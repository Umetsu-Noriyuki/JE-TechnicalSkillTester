{
  "name": "je-technicalskilltester",
  "version": "1.0.0",
  "description": "Technical &amp; Programming skills assessment test web page",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint --fix src/**/*.ts",
    "test": "vitest --passWithNoTests",
    "bundle": "rollup --no-treeshake -c rollup.config.mjs",
    "copy-appsscript": "copyfiles -f src/appsscript.json dist",
    "copy-views": "copyfiles -u 3 \"src/client/views/**/*.html\" dist/client/views",
    "inline-client-script": "node scripts/build/inline-client-script.mjs",
    "build": "npm run lint && npm run test && npm run clean && npm run bundle && npm run copy-appsscript && npm run copy-views && npm run inline-client-script",
    "push": "npm run build && clasp push",
    "security-fix": "npm audit fix",
    "open": "clasp open-container",
    "open-script": "clasp open-script"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umetsu-Noriyuki/JE-TechnicalSkillTester.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Umetsu-Noriyuki/JE-TechnicalSkillTester/issues"
  },
  "homepage": "https://github.com/Umetsu-Noriyuki/JE-TechnicalSkillTester#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/google-apps-script": "^2.0.12",
    "copyfiles": "^2.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-license": "^3.7.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
